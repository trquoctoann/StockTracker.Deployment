# ── Compose Project ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=stocktracker

# vnstock 4.0.7 collector configuration (local lab, conservative request rate)
DATACOLLECTOR_SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
DATACOLLECTOR_VNSTOCK_LISTING_SOURCE=KBS
DATACOLLECTOR_VNSTOCK_INDICES_SOURCE=KBS
DATACOLLECTOR_VNSTOCK_COMPANY_SOURCE=KBS
DATACOLLECTOR_VNSTOCK_QUOTE_SOURCE=KBS
DATACOLLECTOR_VNSTOCK_HISTORY_LOOKBACK_DAYS=30
DATACOLLECTOR_VNSTOCK_PRICE_HISTORY_INTERVAL=1D
DATACOLLECTOR_VNSTOCK_INTRADAY_PAGE_SIZE=100
DATACOLLECTOR_VNSTOCK_INTRADAY_MAX_PAGES=1
DATACOLLECTOR_RATE_LIMIT_VNSTOCK_PER_SECOND=0.25
DATACOLLECTOR_RATE_LIMIT_VNSTOCK_BURST=1

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=stocktracker
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=14

# Keycloak database (created by init script)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Keycloak ─────────────────────────────────────────────────
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true

# ── StockTracker API ─────────────────────────────────────────
# Application
API_APP_NAME=StockTracker.API
API_APP_VERSION=0.0.1
API_DEBUG=true

# Logging
API_ENVIRONMENT=development
API_SERVICE_NAME=API
API_LOG_LEVEL=INFO
API_LOG_JSON=true
API_LOG_SQL=false

# Database
API_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/stocktracker
API_DATABASE_POOL_PRE_PING=true
API_DATABASE_POOL_SIZE=5
API_DATABASE_MAX_OVERFLOW=10

# CORS
API_ALLOWED_ORIGINS=["http://localhost:3000"]

# Pagination
API_DEFAULT_PAGE_SIZE=10
API_MAX_PAGE_SIZE=100

# i18n
API_DEFAULT_LOCALE=en
API_SUPPORTED_LOCALES=["en","vi"]

# OIDC Keycloak
API_OIDC_KEYCLOAK_SERVER_URL=http://keycloak:8080/
API_OIDC_KEYCLOAK_REALM=stocktracker
API_OIDC_KEYCLOAK_CLIENT_ID=stocktracker.api
API_OIDC_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_API_CLIENT_SECRET
API_OIDC_KEYCLOAK_ADMIN_USERNAME=admin
API_OIDC_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
API_OIDC_KEYCLOAK_VERIFY_TLS=false

# Context token
API_AUTH_CONTEXT_TOKEN_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
API_AUTH_CONTEXT_TOKEN_ALGORITHM=HS256
API_AUTH_CONTEXT_TOKEN_TTL_SECONDS=300
API_AUTH_CONTEXT_TOKEN_ISSUER=http://localhost:8000/api

# Redis
API_REDIS_ENABLED=true
API_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
API_REDIS_MAX_CONNECTIONS=10
API_REDIS_SOCKET_CONNECT_TIMEOUT=2
API_REDIS_SOCKET_TIMEOUT=2
API_REDIS_KEY_PREFIX=stocktracker
API_REDIS_KEY_SERVICE_PREFIX=api
API_REDIS_DEFAULT_TTL_SECONDS=300
API_REDIS_CIRCUIT_BREAKER_SECONDS=30

# RabbitMQ
RABBITMQ_USER=stocktracker
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
API_RABBITMQ_ENABLED=true
API_RABBITMQ_URL=amqp://stocktracker:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/
API_RABBITMQ_EXCHANGE_NAME=stocktracker
API_RABBITMQ_EXCHANGE_TYPE=topic
API_RABBITMQ_PREFETCH_COUNT=10
API_RABBITMQ_RECONNECT_DELAY_SECONDS=5
API_RABBITMQ_MAX_RETRIES=3
API_RABBITMQ_RETRY_DELAY_MS=30000

# -- StockTracker DataCollector -------------------------------
DATACOLLECTOR_APP_VERSION=0.1.0
DATACOLLECTOR_LOG_JSON=true
DATACOLLECTOR_API_BASE_URL=http://api:8000
DATACOLLECTOR_KEYCLOAK_BASE_URL=http://keycloak:8080
DATACOLLECTOR_KEYCLOAK_REALM=stocktracker
DATACOLLECTOR_KEYCLOAK_CLIENT_ID=data-collector-service
DATACOLLECTOR_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_DATACOLLECTOR_CLIENT_SECRET
DATACOLLECTOR_HTTP_TIMEOUT_SECONDS=60
DATACOLLECTOR_RABBITMQ_ENABLED=true
DATACOLLECTOR_RABBITMQ_URL=amqp://stocktracker:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/
DATACOLLECTOR_RABBITMQ_EXCHANGE=stocktracker
DATACOLLECTOR_RABBITMQ_EXCHANGE_TYPE=topic
DATACOLLECTOR_CONTROL_PLANE_ENABLED=true
DATACOLLECTOR_CONTROL_DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/stocktracker
DATACOLLECTOR_PIPELINE_HEARTBEAT_SECONDS=30
DATACOLLECTOR_PIPELINE_STALE_AFTER_SECONDS=300
DATACOLLECTOR_RAW_ARCHIVE_ENABLED=true
DATACOLLECTOR_RAW_ARCHIVE_ENDPOINT_URL=http://s3mock:9090
DATACOLLECTOR_RAW_ARCHIVE_ACCESS_KEY=stocktracker
DATACOLLECTOR_RAW_ARCHIVE_SECRET_KEY=CHANGE_ME_RAW_ARCHIVE_SECRET
DATACOLLECTOR_RAW_ARCHIVE_REGION=us-east-1
RAW_ARCHIVE_BUCKET=stocktracker-raw
DATACOLLECTOR_RAW_ARCHIVE_PREFIX=raw
DATACOLLECTOR_RAW_ARCHIVE_SCHEMA_VERSION=1
DATACOLLECTOR_SCHEDULER_ENABLED=false

# ── Grafana ──────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ── Docker Hub ───────────────────────────────────────────────
DOCKER_REGISTRY=docker.io
DOCKER_API_REPO=username/stocktracker-api
DOCKER_DATACOLLECTOR_REPO=username/stocktracker-datacollector
DOCKER_USERNAME=username
DOCKER_PASSWORD=CHANGE_ME_DOCKER_TOKEN

# ── Jenkins ──────────────────────────────────────────────────
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=CHANGE_ME_JENKINS_ADMIN_PASSWORD
