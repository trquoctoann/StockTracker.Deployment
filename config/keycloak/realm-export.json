{
  "realm": "stocktracker",
  "enabled": true,
  "displayName": "StockTracker",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "system_admin",
        "description": "System administrator role for service-to-service communication"
      },
      {
        "name": "data_ingest",
        "description": "Write catalog and market data through ingestion endpoints"
      },
      {
        "name": "pipeline_operator",
        "description": "Start and inspect DataCollector pipeline jobs"
      }
    ]
  },
  "clients": [
    {
      "clientId": "stocktracker.api",
      "name": "StockTracker API",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_API_CLIENT_SECRET",
      "redirectUris": ["http://localhost:8000/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:8000", "http://localhost:3000"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "publicClient": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "data-collector-service",
      "name": "StockTracker DataCollector",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_DATACOLLECTOR_CLIENT_SECRET",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "stocktracker-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stocktracker.api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "collector-introspection-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "data-collector-service",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-data-collector-service",
      "enabled": true,
      "serviceAccountClientId": "data-collector-service",
      "realmRoles": ["data_ingest", "pipeline_operator"]
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email",
    "roles"
  ]
}
